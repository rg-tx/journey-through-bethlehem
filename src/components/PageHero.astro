---
/**
 * Interior pages share a compact painted banner and an aligned paper title.
 */
interface Props {
  kicker?: string;
  title: string;
  lede?: string;
  /** Basename in /images/brand, e.g. "wise-men" (expects -768 variant too). */
  art: string;
  artAlt?: string;
  /** Vertical crop of the painting, e.g. "40%". */
  artY?: string;
}
const { title, lede, art, artAlt = "", artY = "50%" } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-art" style={`--art-y:${artY};`}>
    <img
      src={`/images/brand/${art}.webp`}
      srcset={`/images/brand/${art}-768.webp 768w, /images/brand/${art}.webp 1456w`}
      sizes="100vw"
      alt={artAlt}
      width="1456"
      height="816"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="page-hero-card">
    <div>

      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
  </div>
</section>
