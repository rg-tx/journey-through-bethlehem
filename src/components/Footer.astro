---
import Star from "./Star.astro";
import { event } from "../data/event";

interface Props {
  /** Butt the footer straight against a night section above it. */
  flush?: boolean;
}
const { flush = false } = Astro.props;
---

<footer class:list={["site-footer", { "no-gap": flush }]}>
  <div class="footer-sky" aria-hidden="true">
    <img
      src="/images/brand/night-sky.webp"
      srcset="/images/brand/night-sky-768.webp 768w, /images/brand/night-sky.webp 1456w"
      sizes="100vw"
      alt=""
      width="1456"
      height="816"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="footer-scene">
    <Star size={30} />
    <p class="footer-line">See you in Bethlehem.</p>
  </div>
  <div class="footer-inner">
    <div>
      <p class="footer-brand">Journey through Bethlehem</p>
      <p>
        A free live nativity in Trophy Club, Texas, presented by
        <a href={event.fffUrl} rel="noreferrer">{event.presentedBy}</a> and built each December by
        volunteers from churches across the community.
      </p>
    </div>
    <div>
      <p class="footer-label">Visit</p>
      <ul class="footer-links">
        <li><a href="/tickets">Tickets &amp; showtimes</a></li>
        <li><a href="/tickets#plan-your-visit">Plan your visit</a></li>
        <li><a href={event.mapsUrl} rel="noreferrer">Directions</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-label">Take part</p>
      <ul class="footer-links">
        <li><a href="/get-involved">Volunteer</a></li>
        <li><a href="/get-involved#give-goods">Give goods</a></li>
        <li><a href="/donate">Donate</a></li>
        <li><a href="/partners">Partners</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-label">Say hello</p>
      <ul class="footer-links">
        <li><a href={`mailto:${event.email}`}>{event.email}</a></li>
        <li><a href={event.instagram} rel="noreferrer">Instagram</a></li>
        <li><a href={event.facebook} rel="noreferrer">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-legal">
    <div>
      <span>&copy; {event.year} {event.presentedBy}. A 501(c)(3) nonprofit.</span>
      <span><a href="/privacy-policy">Privacy</a></span>
    </div>
  </div>
</footer>
