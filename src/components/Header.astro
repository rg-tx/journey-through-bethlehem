---
import { nav } from "../data/event";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/">
      <img
        src="/images/brand/wordmark.png"
        alt="Journey through Bethlehem, presented by Faith & Fellowship Foundation"
        width="2000"
        height="706"
      />
    </a>
    <button
      class="nav-toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menu"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
    <nav class="nav" id="site-nav" data-nav aria-label="Primary">
      {
        nav.map((item) => {
          const active = path === item.href;
          return (
            <a href={item.href} aria-current={active ? "page" : undefined} class:list={[{ "is-active": active }]}>
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
