---
import { nav } from "../data/event";
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/">
      <img
        src="/images/brand/wordmark-on-paper.png"
        alt="Journey through Bethlehem, presented by Faith & Fellowship Foundation"
        width="320"
        height="113"
      />
    </a>
    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
    <nav class="nav" id="site-nav" data-nav aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
