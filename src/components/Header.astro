---
import { nav } from "../data/event";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/">
      <img
        class="brand-mark"
        src="/images/brand/wordmark-clean.webp"
        alt="Journey through Bethlehem — home"
        width="1200"
        height="260"
        decoding="async"
      />
    </a>
    <button
      class="nav-toggle"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menu"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
    <nav class="nav" id="site-nav" data-nav aria-label="Primary">
      {
        nav.map((item) => {
          const active = path === item.href;
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[{ "is-active": active, "nav-cta": item.href === "/tickets" }]}
            >
              <span>{item.label}</span>
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
