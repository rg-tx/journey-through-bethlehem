---
/** Privacy notice. Shown once; dismissal is remembered in localStorage. */
---

<aside class="consent" data-consent hidden aria-labelledby="consent-title" aria-describedby="consent-body">
  <p class="consent-title" id="consent-title">A note on privacy</p>
  <p id="consent-body">
    This site sets no advertising or tracking cookies. Reservations and donations happen on Ticket
    Tailor and Stripe, which have their own policies. Read our
    <a href="/privacy-policy">privacy policy</a>.
  </p>
  <div class="actions">
    <button class="btn btn-deep" type="button" data-consent-ok>Okay</button>
  </div>
</aside>

<script>
  const box = document.querySelector<HTMLElement>("[data-consent]");
  const ok = document.querySelector<HTMLButtonElement>("[data-consent-ok]");
  const KEY = "jtb-privacy-notice";
  let seen = false;
  try {
    seen = localStorage.getItem(KEY) === "seen";
  } catch {}
  if (box && !seen && location.pathname !== "/privacy-policy") {
    setTimeout(() => box.removeAttribute("hidden"), 900);
  }
  ok?.addEventListener("click", () => {
    try {
      localStorage.setItem(KEY, "seen");
    } catch {}
    box?.setAttribute("hidden", "");
  });
</script>
