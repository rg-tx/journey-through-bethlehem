---
/**
 * The hero: the comet sky with a headline, no wordmark. The sky fades in, the
 * copy rises, and the comet's star breathes. The painting everyone knows
 * follows in the next module (StableModule).
 */
import { event, hero } from "../data/event";

const stars = [
  { x: 48, y: 12, tw: 5.2, td: 0 }, { x: 62, y: 8, tw: 4.6, td: 2 }, { x: 78, y: 18, tw: 6.4, td: 1 },
  { x: 90, y: 9, tw: 5.5, td: 0.4 }, { x: 8, y: 10, tw: 5.9, td: 1.6 }, { x: 20, y: 6, tw: 4.8, td: 2.7 },
];
---

<section class="sky-hero" aria-labelledby="hero-title" data-sky-hero>
  <img
    class="sky-hero-sky"
    src="/images/brand/comet-sky.webp"
    srcset="/images/brand/comet-sky-768.webp 768w, /images/brand/comet-sky.webp 1456w"
    sizes="100vw"
    alt=""
    width="1456"
    height="728"
    fetchpriority="high"
    decoding="async"
  />
  <div class="sky-hero-stars" aria-hidden="true">
    {stars.map((s) => <i style={`left:${s.x}%;top:${s.y}%;--tw:${s.tw}s;--td:${s.td}s;`}></i>)}
  </div>
  <!-- Layered light stays pinned to the star already painted into the sky. -->
  <div class="sky-hero-star" aria-hidden="true">
    <i class="sky-hero-star-rays"></i>
    <i class="sky-hero-star-core"></i>
  </div>
  <!-- Three crops of the source painting's cloud band create depth without
       introducing a second illustration style. -->
  <div class="sky-hero-cloud sky-hero-cloud-back" aria-hidden="true"></div>
  <div class="sky-hero-cloud sky-hero-cloud-mid" aria-hidden="true"></div>
  <div class="sky-hero-cloud sky-hero-cloud-front" aria-hidden="true"></div>
  <div class="sky-hero-ground" aria-hidden="true"></div>

  <div class="sky-hero-copy">
    <p class="sky-hero-kicker">{hero.kicker}</p>
    <h1 id="hero-title">
      {hero.lead} <em>{hero.emphasis}</em> {hero.tail}
    </h1>
    <p class="sky-hero-voice">{hero.voice}</p>
    <div class="actions">
      <a class="btn btn-gold" href="#showtimes" data-when="prelaunch">See showtimes</a>
      <a class="btn btn-gold" href="/tickets" data-when="open">Reserve a showtime</a>
      <a class="btn btn-gold" href="/tickets" data-when="eventWeek">See tonight’s showtimes</a>
      <a class="btn btn-gold" href="/get-involved" data-when="past">Join us next December</a>
      <a class="btn btn-ghost" href={event.mapsUrl} rel="noreferrer">Get directions</a>
    </div>
  </div>
</section>

<script>
  // Put the glow on the painting's star wherever `object-fit: cover` lands it.
  // The canvas is 2:1; the star sits at (29.2%, 26%); object-position is 30% 22%.
  const heroEl = document.querySelector<HTMLElement>("[data-sky-hero]");
  const place = () => {
    if (!heroEl) return;
    const W = heroEl.clientWidth, H = heroEl.clientHeight;
    const scale = Math.max(W / 2, H);
    const imgW = scale * 2, imgH = scale;
    const offX = (W - imgW) * 0.3, offY = (H - imgH) * 0.22;
    heroEl.style.setProperty("--star-x", `${(((offX + 0.292 * imgW) / W) * 100).toFixed(2)}%`);
    heroEl.style.setProperty("--star-y", `${(((offY + 0.26 * imgH) / H) * 100).toFixed(2)}%`);
  };
  place();
  addEventListener("resize", place, { passive: true });
</script>
