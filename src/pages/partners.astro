---
import Base from "../layouts/Base.astro";
import PartnerGrid from "../components/PartnerGrid.astro";
---

<Base
  title="Partners"
  description="Churches and community organizations that make Journey Through Bethlehem possible."
>
  <section class="page-art" aria-hidden="true">
    <img
      src="/images/brand/night-sky.webp"
      srcset="/images/brand/night-sky-768.webp 768w, /images/brand/night-sky.webp 1456w"
      sizes="100vw"
      alt=""
      width="1456"
      height="816"
      fetchpriority="high"
      decoding="async"
    />
  </section>

  <section class="wrap page-title">
    <p class="kicker">A community production</p>
    <h1>Our partners</h1>
    <p class="lede">
      Bethlehem rises each December because churches, charities, and the Town of Trophy Club build
      it together. These are the organizations that make the walk possible — and the neighbors
      your marketplace gifts support.
    </p>
  </section>

  <section class="wrap">
    <PartnerGrid />
  </section>
</Base>
