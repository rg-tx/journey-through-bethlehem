---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import PartnerGrid from "../components/PartnerGrid.astro";
---

<Base
  title="Partners"
  description="Churches and community organizations that make Journey Through Bethlehem possible."
>
  <PageHero
    kicker="Made possible by"
    title="Our partners"
    lede="Bethlehem rises each December because churches, charities, and the Town of Trophy Club build it together. Several of these organizations also distribute the diapers, food, and toys you bring to the marketplace drives."
    art="sleepy-bethlehem"
    artAlt="The rooftops and tower of Bethlehem glowing at night."
    artY="50%"
  />

  <section class="wrap">
    <PartnerGrid />
  </section>
</Base>
