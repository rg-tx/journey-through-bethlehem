---
import Base from "../layouts/Base.astro";
---

<Base
  title="Donate"
  description="Give to Faith & Fellowship Foundation in support of Journey Through Bethlehem and year-round community service."
>
  <section class="wrap page-title">
    <p class="kicker">Faith & Fellowship Foundation</p>
    <h1>Your support unites us.</h1>
    <p class="lede">
      Help the Faith & Fellowship Foundation create cherished traditions like Journey Through Bethlehem and continue our vital, year-round service to the community. Since we are a 501(c)(3) organization all donations are tax-deductible to the fullest extent permitted by law.
    </p>
  </section>

  <section class="wrap split">
    <form id="donate-form" class="card" novalidate>
      <h2>Make a donation</h2>
      <p id="donate-banner" class="notice" hidden>Donations open soon. This form is ready for Faith & Fellowship Foundation’s Stripe account.</p>

      <p class="kicker">Suggested amounts</p>
      <div class="donate-amounts" role="group" aria-label="Suggested amounts">
        <button type="button" data-amount="10" class="is-on">$10</button>
        <button type="button" data-amount="20">$20</button>
        <button type="button" data-amount="50">$50</button>
        <button type="button" data-amount="100">$100</button>
        <button type="button" data-amount="custom">Custom</button>
      </div>

      <div class="field" id="custom-field" hidden>
        <label for="custom-amount">Custom amount (USD)</label>
        <input id="custom-amount" name="custom" type="number" min="1" step="1" inputmode="numeric" />
      </div>

      <p class="kicker">Frequency</p>
      <div class="freq" role="group" aria-label="Donation frequency">
        <button type="button" data-freq="once" class="is-on">One-time</button>
        <button type="button" data-freq="monthly">Monthly</button>
        <button type="button" data-freq="quarterly">Quarterly</button>
      </div>

      <button class="btn" id="donate-submit" type="submit">Donate</button>
      <p class="status" id="donate-status" role="status"></p>
    </form>

    <figure>
      <img
        class="photo"
        src="/images/photos/marketplace.jpg"
        alt="A smiling volunteer at a marketplace stall during the nativity."
        width="1800"
        height="1201"
      />
      <figcaption class="photo-caption">Gifts support the nativity and year-round work of the Foundation.</figcaption>
    </figure>
  </section>
</Base>

<script>
  const amounts = document.querySelectorAll<HTMLButtonElement>("[data-amount]");
  const freqs = document.querySelectorAll<HTMLButtonElement>("[data-freq]");
  const customField = document.querySelector<HTMLElement>("#custom-field");
  const customInput = document.querySelector<HTMLInputElement>("#custom-amount");
  const form = document.querySelector<HTMLFormElement>("#donate-form");
  const submit = document.querySelector<HTMLButtonElement>("#donate-submit");
  const status = document.querySelector<HTMLElement>("#donate-status");
  const banner = document.querySelector<HTMLElement>("#donate-banner");

  let amount = 10;
  let custom = false;
  let frequency: "once" | "monthly" | "quarterly" = "once";
  let configured = false;

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  function lockForm(message: string) {
    configured = false;
    banner?.removeAttribute("hidden");
    if (submit) {
      submit.disabled = true;
      submit.textContent = "Donations open soon";
      submit.classList.add("is-disabled");
    }
    setStatus(message);
  }

  async function checkConfig() {
    try {
      const res = await fetch("/api/donate-config");
      const data = await res.json();
      if (!data?.configured) {
        lockForm("Stripe is not connected yet. No charge will be made.");
        return;
      }
      configured = true;
    } catch {
      lockForm("Stripe is not connected yet. No charge will be made.");
    }
  }

  amounts.forEach((button) => {
    button.addEventListener("click", () => {
      amounts.forEach((b) => b.classList.remove("is-on"));
      button.classList.add("is-on");
      custom = button.dataset.amount === "custom";
      customField?.toggleAttribute("hidden", !custom);
      if (!custom) amount = Number(button.dataset.amount);
    });
  });

  freqs.forEach((button) => {
    button.addEventListener("click", () => {
      freqs.forEach((b) => b.classList.remove("is-on"));
      button.classList.add("is-on");
      frequency = button.dataset.freq as typeof frequency;
    });
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!configured) return;
    const dollars = custom ? Number(customInput?.value) : amount;
    if (!Number.isFinite(dollars) || dollars < 1) {
      setStatus("Please enter an amount of at least $1.");
      return;
    }
    if (submit) submit.disabled = true;
    setStatus("Opening a secure Stripe checkout…");
    try {
      const res = await fetch("/api/checkout", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ amount: Math.round(dollars * 100), frequency }),
      });
      const data = await res.json();
      if (data.url) {
        window.location.href = data.url;
        return;
      }
      if (data.configured === false) {
        lockForm("Donations open soon. Stripe is not connected yet.");
        return;
      }
      setStatus(data.error || "Unable to start checkout. Please try again.");
    } catch {
      setStatus("Unable to reach checkout. Please try again.");
    }
    if (submit) submit.disabled = false;
  });

  checkConfig();
</script>
