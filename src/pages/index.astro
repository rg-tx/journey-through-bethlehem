---
import Base from "../layouts/Base.astro";
import Star from "../components/Star.astro";
import WalkJourney from "../components/WalkJourney.astro";
import Showtimes from "../components/Showtimes.astro";
import { event, invite, involveCards, partners, nightsUntil } from "../data/event";

const nights = Math.max(1, nightsUntil());
---

<Base
  title="Journey Through Bethlehem | Free Live Nativity in DFW"
  description="You are invited to the 3rd annual live nativity in Trophy Club, Texas. December 3–6, 2026. Free tickets. Presented by Faith & Fellowship Foundation."
>
  <section class="hero" aria-label="Journey through Bethlehem">
    <img
      class="hero-painting"
      src="/images/brand/hero-painting-1456.webp"
      srcset="/images/brand/hero-painting-768.webp 768w, /images/brand/hero-painting-1456.webp 1456w, /images/brand/hero-painting.webp 2000w"
      sizes="100vw"
      alt="A painting of Mary and Joseph kneeling at the manger inside a wooden stable."
      width="2000"
      height="1121"
      fetchpriority="high"
      decoding="async"
    />
    <h1 class="hero-lockup">
      <img
        src="/images/brand/wordmark-presented.webp"
        alt="Journey through Bethlehem. Presented by Faith & Fellowship Foundation."
        width="1600"
        height="416"
        fetchpriority="high"
        decoding="async"
      />
    </h1>
  </section>

  <section class="invite" aria-labelledby="invite-title">
    <div class="invite-art">
      <img
        src="/images/brand/wise-men.webp"
        srcset="/images/brand/wise-men-768.webp 768w, /images/brand/wise-men.webp 1456w"
        sizes="(min-width: 900px) 50vw, 100vw"
        alt="Three wise men on camels crossing the desert toward a bright star."
        width="1456"
        height="816"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="invite-body">
      <p class="kicker">{invite.kicker}</p>
      <h2 id="invite-title">{invite.title}</h2>
      <ul class="facts" aria-label="When and where">
        <li>{event.datesLabel}</li>
        <li><a href={event.mapsUrl} rel="noreferrer">{event.venueName}</a></li>
        <li>{event.venueCity}</li>
        <li><strong>Admission is free</strong></li>
      </ul>
      {invite.body.map((para) => <p>{para}</p>)}
      <div class="actions" data-when="prelaunch">
        <a class="btn" href="#showtimes">See showtimes</a>
        <a class="btn btn-surface" href={event.mapsUrl} rel="noreferrer">Get directions</a>
      </div>
      <div class="actions" data-when="open">
        <a class="btn" href="/tickets">Reserve a showtime</a>
        <a class="btn btn-surface" href={event.mapsUrl} rel="noreferrer">Get directions</a>
      </div>
      <div class="actions" data-when="eventWeek">
        <a class="btn" href="/tickets">See tonight’s showtimes</a>
        <a class="btn btn-surface" href={event.mapsUrl} rel="noreferrer">Get directions</a>
      </div>
      <div class="actions" data-when="past">
        <a class="btn" href="/get-involved">Join us next December</a>
      </div>
      <p class="countdown" data-countdown={event.eventStartIso} data-when="prelaunch open">
        <Star size={18} />
        <span><span data-countdown-nights>{nights}</span> nights until Bethlehem</span>
      </p>
    </div>
  </section>

  <WalkJourney />

  <section class="night-section" id="showtimes" aria-labelledby="showtimes-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Four nights only</p>
          <h2 id="showtimes-title">Showtimes</h2>
          <p class="section-sub">
            Evening walks, {event.datesLabel}. All times Central. Each walk leaves on the hour.
          </p>
        </div>
        <a class="btn btn-gold" href="/tickets" data-when="open eventWeek">Reserve a showtime</a>
        <p class="section-sub" data-when="prelaunch">Free reservations open {event.ticketsOpenLabel}.</p>
      </div>
      <Showtimes tone="night" />
      <p class="night-note">{event.accommodations}</p>
    </div>
  </section>

  <section class="wrap" aria-labelledby="involve-title">
    <div class="section-head">
      <div>
        <p class="kicker">Built by neighbors</p>
        <h2 id="involve-title">Help build Bethlehem</h2>
        <p class="section-sub">
          Every villager, shepherd, and stall-keeper is a volunteer, and the marketplace gives back
          to families across the county.
        </p>
      </div>
      <a class="btn btn-surface" href="/get-involved">All the ways to help</a>
    </div>
    <div class="cards">
      {
        involveCards.map((card, i) => (
          <article class="card" data-reveal style={`--reveal-delay:${i * 90}ms;`}>
            <img
              src={card.src720}
              srcset={`${card.src720} 720w, ${card.src} 1800w`}
              sizes="(min-width: 800px) 30vw, 92vw"
              alt={card.alt}
              width="720"
              height="480"
              loading="lazy"
              decoding="async"
            />
            <div class="card-body">
              <p class="eyebrow">{card.eyebrow}</p>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <a class="card-link" href={card.href} rel="noreferrer">
                {card.action}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap partner-strip" aria-label="Partners">
    <p class="kicker">In partnership with</p>
    <div class="logos">
      {
        partners.map((partner) => (
          <a href={partner.href} rel="noreferrer" title={partner.name}>
            <img src={partner.logo} alt={partner.name} loading="lazy" decoding="async" />
          </a>
        ))
      }
    </div>
  </section>
</Base>
