---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import {
  event,
  foodDriveUrl,
  inKindDrives,
  volunteerAdultUrl,
  volunteerRoles,
  volunteerYouthUrl,
} from "../data/event";
---

<Base
  title="Get involved"
  description="Volunteer or donate in-kind for Journey Through Bethlehem. Sign up to help, or bring diapers, food, and toys to the nativity."
  image="/images/photos/marketplace.jpg"
>
  <PageHero
    kicker="Built by neighbors"
    title="There’s a place for you in the town."
    lede="Bethlehem is built, staffed, and torn down by volunteers. Whether you can give a night in costume or a box of diapers, the town needs you."
    art="shepherd-lamb"
    artAlt="A shepherd carrying a lamb toward a hillside town."
    artY="40%"
  />

  <section class="wrap split split-top" aria-labelledby="volunteer-title">
    <figure class="matted" data-reveal>
      <img
        src="/images/photos/manger-scene-720.jpg"
        srcset="/images/photos/manger-scene-720.jpg 720w, /images/photos/manger-scene.jpg 1800w"
        sizes="(min-width: 900px) 45vw, 92vw"
        alt="A Roman soldier on horseback beside the live nativity cast."
        width="720"
        height="480"
        loading="lazy"
        decoding="async"
      />
      <figcaption>The cast on opening night. Everyone pictured is a volunteer.</figcaption>
    </figure>
    <div>
      <p class="kicker">Volunteer</p>
      <h2 id="volunteer-title">Give a night in costume</h2>
      <p>
        No experience is needed, and costumes are provided. Pick a night and a role on the sign-up
        form; we’ll take it from there. A few of the ways people serve:
      </p>
      <div class="roles">
        {
          volunteerRoles.map((role) => (
            <div class="role">
              <h3>{role.title}</h3>
              <p>{role.body}</p>
            </div>
          ))
        }
      </div>
      <div class="actions">
        <a class="btn btn-deep" href={volunteerAdultUrl} rel="noreferrer">Sign up to volunteer</a>
        <a class="btn btn-surface" href={volunteerYouthUrl} rel="noreferrer">Youth sign-up</a>
      </div>
      <p class="section-sub" style="margin-top: 1rem;">
        Shepherds, angels, and musicians are mostly played by young people, who have their own form.
        Questions about roles or shifts? <a href={`mailto:${event.email}`}>{event.email}</a>
      </p>
    </div>
  </section>

  <section class="wrap" id="give-goods" aria-labelledby="goods-title">
    <div class="section-head">
      <div>
        <p class="kicker">The marketplace gives back</p>
        <h2 id="goods-title">Give goods</h2>
        <p class="section-sub">
          Each drive supports a local partner. Bring items to the drop-off tables at the nativity, or
          shop a list from home and have it shipped.
        </p>
      </div>
      <a class="btn btn-surface" href={foodDriveUrl} rel="noreferrer">Help run the food drive</a>
    </div>
    <div class="drives">
      {
        inKindDrives.map((drive, i) => (
          <article class="drive" data-reveal style={`--reveal-delay:${i * 90}ms;`}>
            <h3>{drive.title}</h3>
            <p class="benefits">
              Benefits{" "}
              <a href={drive.orgHref} rel="noreferrer">
                {drive.org}
              </a>
            </p>
            <p>{drive.body}</p>
            <div class="actions">
              <a class="btn btn-surface" href={drive.amazon} rel="noreferrer">
                {drive.amazonLabel}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>
