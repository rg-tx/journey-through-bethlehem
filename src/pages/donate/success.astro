---
import Base from "../../layouts/Base.astro";
---

<Base title="Thank you" description="Thank you for supporting Faith & Fellowship Foundation.">
  <section class="wrap page-title prose">
    <h1>Thank you.</h1>
    <p>
      Thank you for supporting Faith & Fellowship Foundation. Some payment methods take time to settle. Your payment confirmation and receipt come from Stripe; this page alone does not confirm payment.
    </p>
    <p>For monthly or annual gifts, Stripe charges your chosen amount each billing period until you cancel. You can access the donor portal from our <a href="/donate">donation page</a>.</p>
    <div class="actions">
      <a class="btn" href="/">Back to the nativity</a>
    </div>
  </section>
</Base>
