---
import Base from "../../layouts/Base.astro";
---

<Base title="Donation canceled" description="Your donation was not completed.">
  <section class="wrap page-title prose">
    <p class="kicker">Checkout</p>
    <h1>Donation canceled</h1>
    <p>No charge was made. You can return to the donation page whenever you are ready.</p>
    <div class="actions">
      <a class="btn" href="/donate">Back to donate</a>
    </div>
  </section>
</Base>
