---
import Base from "../layouts/Base.astro";
import { event } from "../data/event";
---

<Base
  title="Tickets"
  description={`Free tickets for Journey Through Bethlehem, December 3–6, 2026 in Trophy Club, Texas. Tickets open ${event.ticketsOpenLabel}.`}
>
  <section class="wrap page-title">
    <p class="kicker">2026 event dates · {event.datesLabel}</p>
    <h1>Tickets</h1>
    <p class="lede">
      Admission is free. Reserve a showtime so we can welcome your family at the gate.
    </p>
  </section>

  <section class="wrap">
    <div class="notice">
      <p>
        <strong>Tickets open {event.ticketsOpenLabel}</strong> at 12:00 a.m. Chicago time.
        The Ticket Tailor series is not on sale yet. When it is published, the same link will open the reservation page.
      </p>
    </div>
    <div class="actions">
      <a class="btn" href={event.ticketsUrl} rel="noreferrer">Get tickets</a>
      <a class="btn btn-ghost" href={event.mapsUrl}>Get directions</a>
    </div>
    <p style="margin-top: 1rem;">
      Reservations are handled by Ticket Tailor. We do not take payment for tickets on this site.
    </p>
  </section>

  <section class="wrap">
    <h2>Showtimes</h2>
    <p>All times are America/Chicago, in the evening.</p>
    <table class="showtimes">
      <thead>
        <tr>
          <th scope="col">Night</th>
          <th scope="col">Performances</th>
        </tr>
      </thead>
      <tbody>
        {
          event.showtimes.map((night) => (
            <tr>
              <th scope="row">{night.date}</th>
              <td>
                <div class="times">
                  {night.times.map((time) => (
                    <span class="time">{time} PM</span>
                  ))}
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="wrap split">
    <div>
      <h2>At the nativity</h2>
      <p>
        Walk the Bethlehem marketplace, hear live music, and end the evening at the manger. Come a little early so there is time for the village before your reserved performance.
      </p>
      <p>
        Sign language is offered at Friday’s 7:00 p.m. show and at every Saturday and Sunday showtime. Spanish translation is offered every night.
      </p>
    </div>
    <img
      class="photo"
      src="/images/photos/choir.jpg"
      alt="The choir in white and gold robes singing on straw."
      width="1800"
      height="1200"
    />
  </section>
</Base>
