---
import Base from "../layouts/Base.astro";
import { event } from "../data/event";
---

<Base
  title="Tickets"
  description={`Free tickets for Journey Through Bethlehem, December 3–6, 2026 in Trophy Club, Texas. Tickets open ${event.ticketsOpenLabel}.`}
>
  <section class="wrap page-title">
    <p class="kicker">Admission is free</p>
    <h1>Tickets</h1>
    <p class="lede">
      Reserve a showtime so we can welcome your family at the gate. Reservations are Ticket Tailor. We do not take payment for tickets on this site.
    </p>
  </section>

  <section class="wrap">
    <div class="notice">
      <p>
        Tickets open November 1, 2026 at 12:00 a.m. Chicago time. The series is not on sale yet. When it is published, the same link will open the reservation page.
      </p>
    </div>
    <div class="actions" style="margin-top: 1.25rem;">
      <a class="btn btn-deep" href={event.ticketsUrl} rel="noreferrer">Get tickets</a>
      <a class="btn btn-surface" href={event.mapsUrl}>Get directions</a>
    </div>
  </section>

  <section class="wrap" id="showtimes">
    <h2>Showtimes</h2>
    <p class="section-sub" style="margin-bottom: 1.25rem;">All times are America/Chicago, in the evening.</p>
    <table class="showtimes">
      <thead>
        <tr>
          <th scope="col">Night</th>
          <th scope="col">Performances</th>
        </tr>
      </thead>
      <tbody>
        {
          event.showtimes.map((night) => (
            <tr>
              <th scope="row">{night.date}</th>
              <td>
                <div class="times">
                  {night.times.map((time) => (
                    <span class="time">{time} PM</span>
                  ))}
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="lede" style="margin-top: 1.5rem;">
      Sign language is offered at Friday’s 7:00 p.m. show and at every Saturday and Sunday showtime. Spanish translation is offered every night. Select the accommodation when you reserve.
    </p>
  </section>
</Base>
