---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Showtimes from "../components/Showtimes.astro";
import { event, faq } from "../data/event";

const half = Math.ceil(faq.length / 2);
const faqCols = [faq.slice(0, half), faq.slice(half)];
---

<Base
  title="Tickets & showtimes"
  description={`Free tickets for Journey Through Bethlehem, December 3–6, 2026 in Trophy Club, Texas. Reservations open ${event.ticketsOpenLabel}.`}
>
  <PageHero
    kicker="Admission is free"
    title="Tickets & showtimes"
    lede="Reserving a showtime costs nothing. It tells us when to welcome your family at the gate and keeps the walk from getting crowded. We never take payment for tickets."
    art="wise-men"
    artAlt="Three wise men on camels following the star."
    artY="45%"
  />

  <section class="wrap" aria-label="Reservations">
    <div data-when="prelaunch">
      <div class="notice">
        <p>
          Free reservations open <strong>{event.ticketsOpenLabel}</strong> and are handled by
          Ticket Tailor. Until then, the showtimes below are the plan for all four nights.
        </p>
      </div>
      <div class="actions" style="margin-top: 1.25rem;">
        <a class="btn btn-surface" href={event.mapsUrl} rel="noreferrer">Get directions</a>
      </div>
    </div>

    <div data-when="open eventWeek">
      <div class="actions">
        <a class="btn btn-deep" href={event.ticketsUrl} rel="noreferrer">Reserve a showtime</a>
        <a class="btn btn-surface" href={event.mapsUrl} rel="noreferrer">Get directions</a>
      </div>
      <p class="section-sub" style="margin-top: 0.9rem;">
        Reservations are handled securely by Ticket Tailor. Tap a time below to go straight to that
        showtime. Popular nights fill.
      </p>
    </div>

    <div data-when="past">
      <div class="notice">
        <p>The {event.year} walk has ended. Thank you for a wonderful four nights.</p>
      </div>
    </div>
  </section>

  <section class="wrap wrap-tight on-paper" id="showtimes" aria-labelledby="schedule-title">
    <div class="section-head">
      <div>
        <p class="kicker">Four nights only</p>
        <h2 id="schedule-title">Showtimes</h2>
        <p class="section-sub">
          Evening walks, {event.datesLabel}. All times Central. Each walk leaves on the hour.
        </p>
      </div>
    </div>
    <Showtimes tone="paper" />
    <p class="section-sub" style="margin-top: 1.5rem; max-width: 52rem;">{event.accommodations}</p>
  </section>

  <section class="wrap" id="plan-your-visit" aria-labelledby="faq-title">
    <div class="section-head">
      <div>
        <p class="kicker">Plan your visit</p>
        <h2 id="faq-title">Good things to know</h2>
      </div>
    </div>
    <div class="faq">
      {
        faqCols.map((col, c) => (
          <div class="faq-col">
            {col.map((item, i) => (
              <details class="reveal" open={c === 0 && i === 0}>
                <summary>{item.q}</summary>
                <div class="reveal-body">
                  <p>{item.a}</p>
                </div>
              </details>
            ))}
          </div>
        ))
      }
    </div>
    <p class="section-sub" style="margin-top: 1.75rem;">
      Questions about group visits or accessibility? Email
      <a href={`mailto:${event.email}`}>{event.email}</a>.
    </p>
  </section>
</Base>
